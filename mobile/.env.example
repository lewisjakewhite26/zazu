# Copy to mobile/.env (same values as root .env)
# Expo inlines EXPO_PUBLIC_* at build time.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat (https://www.revenuecat.com) — for managing Gold subscriptions
# Get your API keys from RevenueCat dashboard (Platform → API Keys)
# You may have separate iOS and Android keys, or use the same key for both
EXPO_PUBLIC_REVENUECAT_IOS_KEY=test_jElKUvhWtgWlyiDpzwiNzaxOvet
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_jElKUvhWtgWlyiDpzwiNzaxOvet

# Apple sign-in configuration
# These come from your Apple Developer account (Certificates, Identifiers & Profiles)
EXPO_PUBLIC_APPLE_SIGN_IN_TEAM_ID=your-apple-team-id-here
EXPO_PUBLIC_APPLE_SIGN_IN_KEY_ID=your-apple-key-id-here

# Google OAuth configuration
# Set up in Google Cloud Console (OAuth 2.0 Client IDs)
# iOS: Your reverse client ID (com.googleusercontent.apps.YOUR_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id-here
