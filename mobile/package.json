  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:usb": "expo start --localhost",
    "android:usb": "adb reverse tcp:8081 tcp:8081 && expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
