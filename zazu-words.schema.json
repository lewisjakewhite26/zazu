{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zazu.app/schemas/words.json",
  "title": "Zazu word library",
  "description": "Array of vocabulary entries for the core daily-alarm word bank (zazu-words.json). Not used by any script today - kept as documentation of the current shape.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["word", "pronunciation", "pos", "definition", "origin", "tier", "rounds", "roots", "introEtymology", "morningTask"],
    "additionalProperties": false,
    "properties": {
      "word": { "type": "string", "minLength": 1 },
      "pronunciation": { "type": "string", "minLength": 1 },
      "pos": { "type": "string", "minLength": 1 },
      "definition": { "type": "string", "minLength": 1 },
      "origin": { "type": "string", "minLength": 1 },
      "tier": { "type": "string", "enum": ["free", "premium"] },
      "rounds": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": ["type", "label", "context", "pairs"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["Etymology", "Definition", "Usage"] },
            "label": { "type": "string", "pattern": "^Round [123] of 3 · (Etymology|Definition|Usage)$" },
            "context": { "type": "string" },
            "pairs": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["a", "b"],
                "additionalProperties": false,
                "properties": {
                  "a": { "type": "string", "minLength": 1 },
                  "b": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      },
      "roots": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["rootText", "rootLanguage", "rootMeaning", "showInIntro"],
          "additionalProperties": false,
          "properties": {
            "rootText": { "type": "string", "minLength": 1 },
            "rootLanguage": { "type": "string", "minLength": 1 },
            "rootMeaning": { "type": "string", "minLength": 1 },
            "showInIntro": { "type": "boolean" }
          }
        }
      },
      "introEtymology": {
        "type": "object",
        "required": ["spans"],
        "additionalProperties": false,
        "properties": {
          "spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["text", "highlight"],
              "additionalProperties": false,
              "properties": {
                "text": { "type": "string" },
                "highlight": { "type": "boolean" }
              }
            }
          }
        }
      },
      "morningTask": {
        "type": "object",
        "required": ["taskType", "sourceKind", "sourceValue", "correctAnswer", "hint", "generatorVersion", "passage"],
        "additionalProperties": false,
        "properties": {
          "taskType": { "type": "string", "enum": ["root", "definition", "etymology"] },
          "sourceKind": { "type": "string", "enum": ["root", "definition", "origin_summary"] },
          "sourceValue": { "type": "string", "minLength": 1 },
          "correctAnswer": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "generatorVersion": { "type": "string", "minLength": 1 },
          "passage": {
            "type": "string",
            "minLength": 1,
            "description": "One natural sentence containing the target word exactly once, validated by lib/word-spotting.ts's isValidPassage()."
          }
        }
      }
    }
  }
}
