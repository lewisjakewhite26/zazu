{
  "name": "zazu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed-words.mjs",
    "seed:dry": "node scripts/seed-words.mjs --dry-run",
    "seed:literary:dry": "node scripts/seed-literary-words.mjs",
    "seed:literary": "node scripts/seed-literary-words.mjs --apply",
    "seed:packs:dry": "node scripts/seed-word-packs.mjs",
    "seed:packs": "node scripts/seed-word-packs.mjs --apply",
    "words:morning-tasks": "node scripts/generate-morning-tasks.mjs",
    "words:morning-tasks:check": "node scripts/generate-morning-tasks.mjs --check",
    "sounds:alarm-chime": "node scripts/generate-alarm-chime.mjs",
    "db:push": "echo Run supabase/migrations/001_create_words_schema.sql in the Supabase SQL Editor, or use: npx supabase db push",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
